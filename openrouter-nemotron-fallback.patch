+/**
+ * OpenRouter text adapter — free `:free` models only, OpenAI-compatible
+ * chat completions.
+ *
+ * Endpoint: POST https://openrouter.ai/api/v1/chat/completions
+ * Free tier (per OpenRouter docs): 20 RPM, 50 requests/day; 1,000/day
+ * only after $10 lifetime credits — that threshold is optional and is
+ * NOT needed for the hub fallback lane, so never present it as a step.
+ * Requires a free OPENROUTER_API_KEY (user creates it at
+ * openrouter.ai/keys, no card; never in chat).
+ *
+ * The free list ROTATES: IDs live in the hub as env config
+ * (HUB_OPENROUTER_*_MODEL), never hardcoded into a call. Verified free
+ * 2026-11-10 (OpenRouter models API snapshots, 8–9 Nov 2026):
+ * nvidia/nemotron-3-ultra-550b-a55b:free (550B MoE, 1M context,
+ * strongest free reasoning) and nvidia/nemotron-3.5-super-vl:free
+ * (120B/12B active MoE, 1M context, fastest free all-rounder —
+ * 20/20 answered in the 28 Oct–6 Nov 2026 benchmark). Re-check the
+ * live list at deploy; a rotated ID fails honestly as unavailable.
+ */
+import { z } from "zod";
+import {
+  backoffDelayMs,
+  errResult,
+  okResult,
+  requireEnv,
+  sleep,
+  type ProviderResult,
+} from "./types";
+
+export const PROVIDER_KEY = "openrouter";
+
+const ENDPOINT = "https://openrouter.ai/api/v1/chat/completions";
+
+const GenerateTextInputSchema = z.object({
+  prompt: z.string().min(1).max(8000),
+  maxTokens: z.number().int().min(64).max(4096).default(1024),
+  temperature: z.number().min(0).max(2).default(0.7),
+  model: z.string().min(1).optional(),
+});
+
+const MAX_RETRIES = 2;
+const TIMEOUT_MS = 60_000;
+
+export function isConfigured(): boolean {
+  return requireEnv("OPENROUTER_API_KEY") !== null;
+}
+
+export function defaultModel(): string {
+  return process.env.OPENROUTER_MODEL || "nvidia/nemotron-3.5-super-vl:free";
+}
+
+export async function generateText(
+  input: z.input<typeof GenerateTextInputSchema>
+): Promise<ProviderResult<string>> {
+  const parsed = GenerateTextInputSchema.safeParse(input);
+  if (!parsed.success) {
+    return errResult(PROVIDER_KEY, {
+      code: "invalid_input",
+      message: "Invalid text-generation input.",
+      retryable: false,
+    });
+  }
+  const apiKey = requireEnv("OPENROUTER_API_KEY");
+  if (!apiKey) {
+    return errResult(PROVIDER_KEY, {
+      code: "not_configured",
+      message: "Missing OPENROUTER_API_KEY — create a free key at openrouter.ai/keys.",
+      retryable: false,
+    });
+  }
+  const { prompt, maxTokens, temperature } = parsed.data;
+  const model = parsed.data.model || defaultModel();
+  const started = Date.now();
+  let lastDetail = "";
+
+  for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
+    try {
+      const res = await fetch(ENDPOINT, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          authorization: `Bearer ${apiKey}`,
+        },
+        body: JSON.stringify({
+          model,
+          messages: [{ role: "user", content: prompt }],
+          max_tokens: maxTokens,
+          temperature,
+        }),
+        signal: controller.signal,
+      });
+      clearTimeout(timer);
+      if (res.status === 429) {
+        lastDetail = "http=429 rate limited";
+        if (attempt < MAX_RETRIES) await sleep(backoffDelayMs(attempt, 3000, 30000));
+        continue;
+      }
+      if (!res.ok) {
+        lastDetail = `http=${res.status}`;
+        if (attempt < MAX_RETRIES) await sleep(backoffDelayMs(attempt, 2000, 20000));
+        continue;
+      }
+      const body = (await res.json()) as {
+        choices?: Array<{ message?: { content?: string } }>;
+      };
+      const content = body.choices?.[0]?.message?.content?.trim();
+      if (!content) {
+        lastDetail = "empty choices in response";
+        if (attempt < MAX_RETRIES) await sleep(backoffDelayMs(attempt, 2000, 20000));
+        continue;
+      }
+      return okResult(PROVIDER_KEY, content, { model, durationMs: Date.now() - started });
+    } catch (err) {
+      clearTimeout(timer);
+      const msg = err instanceof Error ? err.message : String(err);
+      lastDetail = msg.includes("abort") ? "timeout" : msg.slice(0, 120);
+      if (attempt < MAX_RETRIES) await sleep(backoffDelayMs(attempt, 2000, 20000));
+    }
+  }
+  return errResult(PROVIDER_KEY, {
+    code: "unavailable",
+    message: `OpenRouter did not return text after ${MAX_RETRIES + 1} attempts. Last: ${lastDetail}`,
+    retryable: true,
+  });
+}
