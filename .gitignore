# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# runtime state: job assets, renders, quota/ledger counters (277M+).
# The registry config is force-added anyway (see below) — it is the one
# file under storage/ that is source, not state.
# (Force-add it: git add -f storage/tool-registry.json)
/storage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
