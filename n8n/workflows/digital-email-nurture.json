        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.BREVO_API_KEY }}"
            }
          ]
        },
        "onError": "continueRegularOutput",
        "jsonBody": "={\"email\":\"={{ $json.email }}\",\"attributes\":{\"FIRSTNAME\":\"={{ $json.name }}\"}}"
      }
    },
