      "parameters": {
        "httpMethod": "POST",
        "options": {
          "responseMode": "responseNode"
        },
        "path": "digital-nurture"
      },
      "webhookId": "dace44f2-0a27-54cb-8eb0-5a0862395097"
    },
    {
      "id": "validate",
      "name": "validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers ?? {};\nconst provided = String(headers['x-n8n-secret'] ?? headers['X-N8N-Secret'] ?? '');\nconst expected = String($env.N8N_WEBHOOK_SECRET ?? '');\nif (!expected) throw new Error('N8N_WEBHOOK_SECRET is not configured in n8n');\nif (provided.length !== expected.length) throw new Error('Unauthorized: bad webhook secret');\nlet diff = 0;\nfor (let i = 0; i < expected.length; i++) diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i);\nif (diff !== 0) throw new Error('Unauthorized: bad webhook secret');\nconst body = item.body ?? item;\nconst email = String(body.email ?? '').trim();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email))\n  return [{ json: { valid: false, error: 'valid email zaroori hai' } }];\nreturn [{ json: { valid: true, email,\n  name: String(body.name ?? '').slice(0, 60),\n  productName: String(body.productName ?? 'hamara product').slice(0, 80),\n  freebieName: String(body.freebieName ?? 'free guide').slice(0, 80),\n  freebieUrl: String(body.freebieUrl ?? '').slice(0, 300) } }];\n"
      }
    },
    {
      "id": "if-valid",
      "name": "if-valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "parameters": {
        "combineOperation": "all",
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.valid }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "respond-invalid",
      "name": "respond-invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        460
      ],
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    },
    {
      "id": "brevo-contact",
      "name": "brevo-contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "notes": "Create/update Brevo contact.",
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/contacts",
        "sendBody": true,
