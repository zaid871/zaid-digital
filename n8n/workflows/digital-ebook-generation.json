    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers ?? {};\nconst provided = String(headers['x-n8n-secret'] ?? headers['X-N8N-Secret'] ?? '');\nconst expected = String($env.N8N_WEBHOOK_SECRET ?? '');\nif (!expected) throw new Error('N8N_WEBHOOK_SECRET is not configured in n8n');\nif (provided.length !== expected.length) throw new Error('Unauthorized: bad webhook secret');\nlet diff = 0;\nfor (let i = 0; i < expected.length; i++) diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i);\nif (diff !== 0) throw new Error('Unauthorized: bad webhook secret');\nconst body = item.body ?? item;\n\nconst topic = String(body.topic ?? '').trim();\nif (topic.length < 3) return [{ json: { valid: false, error: 'topic (min 3 chars) zaroori hai' } }];\nconst payload = { topic };\nfor (const k of ['title','audience','authorName','writingStyle']) if (body[k] !== undefined) payload[k] = body[k];\nif (body.language !== undefined) payload.language = body.language;\nif (body.chapters !== undefined) payload.chapters = body.chapters;\nif (body.wordsPerChapter !== undefined) payload.wordsPerChapter = body.wordsPerChapter;\nif (body.format !== undefined) payload.format = body.format;\nif (body.pages !== undefined) payload.pages = body.pages;\nreturn [{ json: { valid: true, type: 'ebook', payload, demandKey: topic,\n  skipDemandCheck: body.skipDemandCheck === true, retries: 0 } }];",
        "mode": "runOnceForAllItems"
      },
