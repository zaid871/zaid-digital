{
  "name": "digital: freebie-delivery",
  "nodes": [
    {
      "id": "webhook-entry",
      "name": "webhook-entry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "notes": "Freebie request \u2192 download link respond + nurture trigger.",
      "parameters": {
        "httpMethod": "POST",
        "options": {
          "responseMode": "responseNode"
        },
        "path": "digital-freebie"
      },
      "webhookId": "dace44f2-0a27-54cb-8eb0-5a0862395097"
    },
    {
      "id": "validate",
      "name": "validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers ?? {};\nconst provided = String(headers['x-n8n-secret'] ?? headers['X-N8N-Secret'] ?? '');\nconst expected = String($env.N8N_WEBHOOK_SECRET ?? '');\nif (!expected) throw new Error('N8N_WEBHOOK_SECRET is not configured in n8n');\nif (provided.length !== expected.length) throw new Error('Unauthorized: bad webhook secret');\nlet diff = 0;\nfor (let i = 0; i < expected.length; i++) diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i);\nif (diff !== 0) throw new Error('Unauthorized: bad webhook secret');\nconst body = item.body ?? item;\nconst email = String(body.email ?? '').trim();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email))\n  return [{ json: { valid: false, error: 'valid email zaroori hai' } }];\nif (!body.freebieUrl) return [{ json: { valid: false, error: 'freebieUrl zaroori hai' } }];\nreturn [{ json: { valid: true, email, name: String(body.name ?? '').slice(0, 60),\n  productName: String(body.productName ?? '').slice(0, 80),\n  freebieName: String(body.freebieName ?? 'free guide').slice(0, 80),\n  freebieUrl: String(body.freebieUrl).slice(0, 300) } }];\n"
      }
    },
    {
      "id": "if-valid",
      "name": "if-valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "parameters": {
        "combineOperation": "all",
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.valid }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "respond-invalid",
      "name": "respond-invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        460
      ],
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    },
    {
      "id": "trigger-nurture",
      "name": "trigger-nurture",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "notes": "Fire-and-forget nurture trigger (nurture webhook responds immediately).",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_PUBLIC_URL }}/webhook/digital-nurture",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "onError": "continueRegularOutput"
      }
    },
    {
      "id": "respond-link",
      "name": "respond-link",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        960,
        300
      ],
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"downloadUrl\":\"={{ $json.freebieUrl }}\"}"
      }
    }
  ],
  "connections": {
    "webhook-entry": {
      "main": [
        [
          {
            "node": "validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "validate": {
      "main": [
        [
          {
            "node": "if-valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "if-valid": {
      "main": [
        [
          {
            "node": "trigger-nurture",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "respond-invalid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "trigger-nurture": {
      "main": [
        [
          {
            "node": "respond-link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "affiliate-system"
    }
  ],
  "notes": "Freebie delivery + nurture trigger. Tripwire page = selling layer (parked).",
  "errorWorkflow": "digital-error-recovery"
}