      "main": [
        [
          {
            "node": "init-proc-poll",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "park-container-fail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "park-container-fail": {
      "main": [
        [
          {
            "node": "loop-variants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "init-proc-poll": {
      "main": [
        [
          {
            "node": "check-processing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check-processing": {
      "main": [
        [
          {
            "node": "normalize-proc",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "normalize-proc": {
      "main": [
        [
          {
            "node": "is-proc-done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "is-proc-done": {
      "main": [
        [
          {
            "node": "if-proc-ok",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "proc-within-limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "if-proc-ok": {
