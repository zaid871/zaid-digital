          }
        ],
        [
          {
            "node": "wait-until-slot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "wait-until-slot": {
      "main": [
        [
          {
            "node": "create-variant-container",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
