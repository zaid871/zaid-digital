{
  "name": "affiliate: pinterest-volume",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "schedule-trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "notes": "Weekly Wednesdays 06:30 IST (01:00 UTC).",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 1 * * 3"
            }
          ]
        }
      }
    },
    {
      "id": "load-queue",
      "name": "load-queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "notes": "Products from DIGITAL_PINTEREST_QUEUE_JSON env.",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = String($env.AFFILIATE_PINTEREST_QUEUE_JSON ?? '[]');\nlet queue = [];\ntry { queue = JSON.parse(raw); } catch (e) { queue = []; }\nif (!Array.isArray(queue) || !queue.length)\n  return [{ json: { empty: true } }];\nreturn queue.map(p => ({ json: { empty: false, product: p } }));\n"
      }
    },
    {
      "id": "if-empty",
      "name": "if-empty",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "parameters": {
        "combineOperation": "all",
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.empty }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "volume",
      "name": "volume",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "notes": "7 distinct pins per product.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/v1/publishing/pinterest-volume",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"product\":{{ $json.product }},\"count\":7}",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "onError": "continueRegularOutput"
      }
    },
    {
      "id": "log",
      "name": "log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;const d=r.data??r;console.log(`pinterest volume (affiliate): ${d.published??0}/${d.total??0} published`);return [{json:{ok:true}}];"
      }
    }
  ],
  "connections": {
    "schedule-trigger": {
      "main": [
        [
          {
            "node": "load-queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "load-queue": {
      "main": [
        [
          {
            "node": "if-empty",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "if-empty": {
      "main": [
        [
          {
            "node": "log",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "volume",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "volume": {
      "main": [
        [
          {
            "node": "log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "affiliate-system"
    }
  ],
  "notes": "Weekly 7 distinct pins per affiliate product (compounding). Queue: AFFILIATE_PINTEREST_QUEUE_JSON — same shape as the digital queue ([{name, category, link, imageUrl, description?, features?}]). Calls the same generic /api/v1/publishing/pinterest-volume endpoint.",
  "errorWorkflow": "affiliate-error-recovery",
  "active": false
}