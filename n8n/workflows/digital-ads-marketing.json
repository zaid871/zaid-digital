    {
      "parameters": {
        "jsCode": "const j = $('build-reels-payload').first().json;\nconst pub = $('call-multi-publish').first().json;\nconst results = pub && pub.data ? (pub.data.results ?? pub.data) : null;\nreturn [{ json: { ok: true, productType: j.productType, productName: j.productName,\n  jobId: j.jobId, jobStatus: j.status,\n  reelsReady: !!j.reelsReady, reelsReason: j.reelsReason ?? null,\n  reelsTriggered: { instagram: !!j.reelsReady, facebook: !!j.reelsReady },\n  publishSkipped: !!j.publishSkipped, publish: results } }];",
        "mode": "runOnceForAllItems"
