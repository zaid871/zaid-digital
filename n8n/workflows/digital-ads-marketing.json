    {
      "parameters": {
        "jsCode": "const j = $('build-reels-payload').first().json;\nif (j.publish === false) return [{ json: { ...j, publishSkipped: true } }];\nconst category = { ebook: 'ebook', template_pack: 'templates', pod: 'apparel', website: 'website' }[j.productType] || 'digital';\nconst product = { name: j.productName, category, link: j.productLink };\nif (j.productDescription) product.description = j.productDescription;\nif (j.features && j.features.length) product.features = j.features;\nconst out = { ...j, publishPayload: { product } };\nif (j.platforms && j.platforms.length) out.publishPayload.platforms = j.platforms;\nif (j.subreddit) out.publishPayload.subreddit = j.subreddit;\nif (j.question) out.publishPayload.question = j.question;\nreturn [{ json: out }];",
        "mode": "runOnceForAllItems"
      },
      "id": "b7c40f5f-42aa-4ffe-b019-b3e780788d75",
      "name": "build-publish-payload",
