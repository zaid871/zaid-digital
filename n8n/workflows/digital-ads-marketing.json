    {
      "parameters": {
        "jsCode": "// Build the IG/FB reels payload from the completed job.\n// downloadUrl comes from GET /api/v1/jobs/:id/result (video.downloadUrl is\n// a relative signed path /api/v1/jobs/:id/download?key=... \u2014 the bare\n// /download URL without ?key= returns 400, so never use that).\n// Caption is built from the product's own fields: no price, no fake claims.\nconst res = $input.first().json;\nconst p = $('normalize-status').first().json;\nif (p.publish === false) return [{ json: { ...p, reelsReady: false, reelsReason: 'publish_disabled' } }];\nconst base = String($env.BACKEND_URL ?? '').replace(/\\/$/, '');\nconst video = res && res.ok === true && res.data ? res.data.video : null;\nconst rel = video && video.downloadUrl ? String(video.downloadUrl) : '';\nlet caption = p.productName || '';\nif (p.productDescription) caption += '\\n\\n' + p.productDescription;\nconst feats = Array.isArray(p.features) ? p.features.slice(0, 3) : [];\nif (feats.length) caption += '\\n' + feats.map(f => '\u2713 ' + f).join('\\n');\ncaption += '\\n\\nDetails: ' + p.productLink;\nif (!rel) return [{ json: { ...p, reelsReady: false, reelsReason: 'no_video_url' } }];\nreturn [{ json: { ...p, reelsReady: true, downloadUrl: base + rel,\n  product: { name: p.productName, link: p.productLink, productType: p.productType, niche: p.niche, script: { caption } } } }];",
        "mode": "runOnceForAllItems"
      },
