    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers ?? {};\nconst provided = String(headers['x-n8n-secret'] ?? headers['X-N8N-Secret'] ?? '');\nconst expected = String($env.N8N_WEBHOOK_SECRET ?? '');\nif (!expected) throw new Error('N8N_WEBHOOK_SECRET is not configured in n8n');\nif (provided.length !== expected.length) throw new Error('Unauthorized: bad webhook secret');\nlet diff = 0;\nfor (let i = 0; i < expected.length; i++) diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i);\nif (diff !== 0) throw new Error('Unauthorized: bad webhook secret');\nconst body = item.body ?? item;\n\nconst productType = String(body.productType ?? '');\nif (!['ebook','template_pack','pod','website'].includes(productType))\n  return [{ json: { valid: false, error: 'productType ebook | template_pack | pod | website hona chahiye' } }];\nconst productName = String(body.productName ?? '').trim();\nif (productName.length < 3)\n  return [{ json: { valid: false, error: 'productName (min 3 chars) zaroori hai' } }];\nconst productLink = String(body.productLink ?? '').trim();\nif (!/^https?:\\/\\/.+/.test(productLink))\n  return [{ json: { valid: false, error: 'productLink valid http(s) URL hona chahiye' } }];\nconst durationSeconds = Math.min(180, Math.max(15, Number(body.durationSeconds ?? 45) || 45));\nreturn [{ json: { valid: true, productType, productName, productLink,\n  productDescription: String(body.productDescription ?? '').slice(0, 1000),\n  features: Array.isArray(body.features) ? body.features.slice(0, 8).map(String) : [],\n  durationSeconds, publish: body.publish !== false,\n  niche: body.niche !== undefined ? String(body.niche).slice(0, 100) : undefined,\n  subreddit: typeof body.subreddit === 'string' && body.subreddit.trim() ? body.subreddit.trim().slice(0, 100) : undefined,\n  platforms: Array.isArray(body.platforms) ? body.platforms.filter(p => ['pinterest','linkedin','x','reddit','quora','threads'].includes(p)) : undefined,\n  question: typeof body.question === 'string' && body.question.trim() ? body.question.trim().slice(0, 500) : undefined } }];",
        "mode": "runOnceForAllItems"
      },
