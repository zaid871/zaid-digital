    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers ?? {};\nconst provided = String(headers['x-n8n-secret'] ?? headers['X-N8N-Secret'] ?? '');\nconst expected = String($env.N8N_WEBHOOK_SECRET ?? '');\nif (!expected) throw new Error('N8N_WEBHOOK_SECRET is not configured in n8n');\nif (provided.length !== expected.length) throw new Error('Unauthorized: bad webhook secret');\nlet diff = 0;\nfor (let i = 0; i < expected.length; i++) diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i);\nif (diff !== 0) throw new Error('Unauthorized: bad webhook secret');\nconst body = item.body ?? item;\nconst productName = String(body.productName ?? '').trim();\nif (productName.length < 2) return [{ json: { valid: false, error: 'productName zaroori hai' } }];\nconst payload = { productName };\nfor (const k of ['productType','productDescription','features','audience','outcomes','niche','handle','theme','designStyle']) if (body[k] !== undefined) payload[k] = body[k];\nconst demandKey = String(body.niche ?? productName).trim();\nreturn [{ json: { valid: true, type: 'marketing_toolkit', payload, demandKey,\n  skipDemandCheck: body.skipDemandCheck === true, retries: 0 } }];",
        "mode": "runOnceForAllItems"
      },
