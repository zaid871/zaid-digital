    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers ?? {};\nconst provided = String(headers['x-n8n-secret'] ?? headers['X-N8N-Secret'] ?? '');\nconst expected = String($env.N8N_WEBHOOK_SECRET ?? '');\nif (!expected) throw new Error('N8N_WEBHOOK_SECRET is not configured in n8n');\nif (provided.length !== expected.length) throw new Error('Unauthorized: bad webhook secret');\nlet diff = 0;\nfor (let i = 0; i < expected.length; i++) diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i);\nif (diff !== 0) throw new Error('Unauthorized: bad webhook secret');\nconst body = item.body ?? item;\nconst type = String(body.type ?? '');\nif (!['ebook', 'template_pack'].includes(type)) {\n  return [{ json: { valid: false, error: 'type must be \"ebook\" or \"template_pack\"' } }];\n}\nif (type === 'ebook' && String(body.topic ?? '').trim().length < 3) {\n  return [{ json: { valid: false, error: 'ebook ke liye topic (kam se kam 3 characters) zaroori hai' } }];\n}\nif (type === 'template_pack' && String(body.niche ?? '').trim().length < 2) {\n  return [{ json: { valid: false, error: 'template_pack ke liye niche zaroori hai' } }];\n}\nconst payload = { ...body };\ndelete payload.type;\nreturn [{ json: { valid: true, type, payload } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "3a40e062-f242-4279-8e8b-bf325c6b444d",
      "name": "validate-input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
