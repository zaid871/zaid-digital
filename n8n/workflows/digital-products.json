      },
      "id": "77a54643-1281-428b-8e97-05482dafcd48",
      "name": "call-templates-api",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nlet type = 'unknown';\ntry { type = $('validate-input').first().json.type ?? 'unknown'; } catch {}\nif (r && r.ok === true && r.data) {\n  const d = r.data;\n  return [{ json: { ok: true, type, title: d.title ?? d.packName ?? '', dir: d.dir ?? '', files: d.files ?? {}, warnings: d.warnings ?? [] } }];\n}\nreturn [{ json: { ok: false, type, error: (r && (r.message ?? r.error)) || 'Digital product generation failed', code: (r && r.code) || 'generation_failed' } }];",
        "mode": "runOnceForAllItems"
      },
