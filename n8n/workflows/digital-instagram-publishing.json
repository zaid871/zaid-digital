        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ imageUrls: $('webhook-entry').first().json.body.imageUrls, caption: $('webhook-entry').first().json.body.caption, productType: $('webhook-entry').first().json.body.productType }) }}",
        "onError": "continueRegularOutput"
      },
      "id": "6e59fb04-c9b0-4570-a335-3c55cab82c07",
      "name": "call-carousel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
