        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ productType: ($('webhook-entry').first().json.body.product || {}).productType, niche: ($('webhook-entry').first().json.body.product || {}).niche, accountKey: $('webhook-entry').first().json.body.accountKey }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "resolve-account",
      "name": "resolve-account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1330,
        300
      ]
    }
  ],
